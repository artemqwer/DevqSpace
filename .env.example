# =====================================================
# Telegram інтеграція (сповіщення про замовлення)
# =====================================================
# Створіть бота через @BotFather → отримайте токен
TELEGRAM_BOT_TOKEN=

# Ваш chat_id куди надсилати замовлення.
# Дізнатися: після деплою напишіть боту /where — він поверне chat_id.
TELEGRAM_ADMIN_CHAT_ID=

# Випадковий рядок (32+ символи). Telegram пересилає його в кожному
# webhook-update — захищає endpoint від чужих запитів.
# Згенерувати: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Випадковий рядок для одноразового виклику /api/tg-webhook/setup
# Згенерувати: openssl rand -hex 16
TELEGRAM_SETUP_KEY=


# =====================================================
# Локальна розробка (dev-заглушки)
# =====================================================
# Поза продом порожні ключі нижче вмикають заглушки: файлове сховище замість
# Vercel Blob, скринька /dev/inbox замість Resend, /dev/pay/* замість
# NOWPayments і банки, лог замість Telegram. Вписав справжній ключ — заглушка
# для нього вимкнулась. У проді (NODE_ENV=production) заглушок не існує.
#
# Вимкнути всі заглушки локально:
# DEVQ_DEV_STUBS=off
#
# Базовий URL для абсолютних посилань, які генеруються поза контекстом запиту
# (посилання на файл у листі). За замовч. http://localhost:3000
# DEVQ_PUBLIC_URL=http://localhost:3000


# =====================================================
# Адмінка
# =====================================================
# Пароль для входу в /admin
ADMIN_PASSWORD=

# Секрет для підпису сесійної cookie (32+ символи).
# Згенерувати: openssl rand -hex 32
# Якщо не задано — використає ADMIN_PASSWORD (краще задати окремо).
ADMIN_SESSION_SECRET=

# Ключ шифрування .env-значень, які клієнт вводить при замовленні
# (там його бойовий BOT_TOKEN). AES-256-GCM, 32+ символи.
# Згенерувати: openssl rand -hex 32
# Якщо не задано — використає ADMIN_SESSION_SECRET.
ENV_DATA_SECRET=


# =====================================================
# База даних замовлень/товарів — Upstash Redis
# =====================================================
# Підключіть Upstash Redis через Vercel Marketplace (Storage → Create)
# і ці змінні додадуться автоматично. Локально без них працює in-memory
# fallback (дані не зберігаються між перезапусками).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (альтернативні назви, якщо інтеграція додала KV_*)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=


# =====================================================
# Завантаження зображень товарів — Vercel Blob (опційно)
# =====================================================
# Підключіть Vercel Blob через Storage. Без нього можна вставляти
# URL картинок вручну у формі товару.
BLOB_READ_WRITE_TOKEN=


# =====================================================
# Крипто-оплата на сайті (без Telegram) — NOWPayments
# =====================================================
# Реєстрація: https://nowpayments.io → Settings → API keys.
# Якщо порожньо — кнопка оплати на товарах ховається.
NOWPAYMENTS_API_KEY=
# IPN secret (Settings → IPN/Instant Payment Notifications → секрет).
# Потрібен для перевірки підпису вебхука оплати.
NOWPAYMENTS_IPN_SECRET=
#
# У кабінеті NOWPayments → IPN → вкажіть callback URL:
#   https://<домен>/api/pay/now/webhook

# =====================================================
# Оплата карткою / Apple Pay / Google Pay — WayForPay
# =====================================================
# Кабінет: https://m.wayforpay.com → Реквізити мерчанта.
# Якщо порожньо — кнопка "Оплатити карткою" ховається.
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET=
# Домен мерчанта (як у налаштуваннях WayForPay). За замовч. devq.space.
WAYFORPAY_DOMAIN=devq.space
# serviceUrl (callback оплати) прописувати НЕ треба — передаємо в кожному
# інвойсі автоматично: https://<домен>/api/pay/wfp/callback


# =====================================================
# Оплата карткою — банка Monobank (без ФОП)
# =====================================================
# Створіть банку в додатку Monobank → поділитись → скопіюйте посилання.
# Якщо порожньо — кнопка "Сплатити карткою" ховається.
# Підтвердження оплати — вручну (кнопка в Telegram / адмінці).
MONOBANK_JAR_URL=
# Курс $ → грн рахується АВТОМАТИЧНО (Monobank API → НБУ, кеш 1 год).
# Ця змінна — лише ФОЛБЕК, якщо обидва API недоступні. За замовч. 42.
USD_UAH_RATE=42


# =====================================================
# Видача товару на email — Resend
# =====================================================
# Реєстрація: https://resend.com → API Keys → створіть ключ.
# Якщо порожньо — email-видача не працює (Telegram-видача працює без цього).
RESEND_API_KEY=
# Адреса відправника. Для проду верифікуйте свій домен у Resend і вкажіть,
# напр. "NEXUS <noreply@ваш-домен.com>". Для тесту можна лишити порожнім —
# використається onboarding@resend.dev.
RESEND_FROM=
