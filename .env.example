# =====================================================
# Telegram інтеграція
# =====================================================
#
# Створіть бота через @BotFather → отримайте токен
TELEGRAM_BOT_TOKEN=

# Ваш chat_id куди надсилати замовлення.
# Дізнатися: після деплою напишіть боту /where — він поверне chat_id.
TELEGRAM_ADMIN_CHAT_ID=

# Випадковий рядок (32+ символи). Telegram пересилає його в кожному
# webhook-update — це захищає endpoint від чужих запитів.
# Згенерувати: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Випадковий рядок для одноразового виклику /api/tg-webhook/setup
# Згенерувати: openssl rand -hex 16
TELEGRAM_SETUP_KEY=
