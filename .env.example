# =====================================================
# Telegram інтеграція (сповіщення про замовлення)
# =====================================================
# Створіть бота через @BotFather → отримайте токен
TELEGRAM_BOT_TOKEN=

# Ваш chat_id куди надсилати замовлення.
# Дізнатися: після деплою напишіть боту /where — він поверне chat_id.
TELEGRAM_ADMIN_CHAT_ID=

# Випадковий рядок (32+ символи). Telegram пересилає його в кожному
# webhook-update — захищає endpoint від чужих запитів.
# Згенерувати: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Випадковий рядок для одноразового виклику /api/tg-webhook/setup
# Згенерувати: openssl rand -hex 16
TELEGRAM_SETUP_KEY=


# =====================================================
# Адмінка
# =====================================================
# Пароль для входу в /admin
ADMIN_PASSWORD=

# Секрет для підпису сесійної cookie (32+ символи).
# Згенерувати: openssl rand -hex 32
# Якщо не задано — використає ADMIN_PASSWORD (краще задати окремо).
ADMIN_SESSION_SECRET=


# =====================================================
# База даних замовлень/товарів — Upstash Redis
# =====================================================
# Підключіть Upstash Redis через Vercel Marketplace (Storage → Create)
# і ці змінні додадуться автоматично. Локально без них працює in-memory
# fallback (дані не зберігаються між перезапусками).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (альтернативні назви, якщо інтеграція додала KV_*)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=


# =====================================================
# Завантаження зображень товарів — Vercel Blob (опційно)
# =====================================================
# Підключіть Vercel Blob через Storage. Без нього можна вставляти
# URL картинок вручну у формі товару.
BLOB_READ_WRITE_TOKEN=


# =====================================================
# Крипто-оплата на сайті (без Telegram) — NOWPayments
# =====================================================
# Реєстрація: https://nowpayments.io → Settings → API keys.
# Якщо порожньо — кнопка оплати на товарах ховається.
NOWPAYMENTS_API_KEY=
# IPN secret (Settings → IPN/Instant Payment Notifications → секрет).
# Потрібен для перевірки підпису вебхука оплати.
NOWPAYMENTS_IPN_SECRET=
#
# У кабінеті NOWPayments → IPN → вкажіть callback URL:
#   https://<домен>/api/pay/now/webhook


# =====================================================
# Оплата карткою — банка Monobank (без ФОП)
# =====================================================
# Створіть банку в додатку Monobank → поділитись → скопіюйте посилання.
# Якщо порожньо — кнопка "Сплатити карткою" ховається.
# Підтвердження оплати — вручну (кнопка в Telegram / адмінці).
MONOBANK_JAR_URL=
# Курс $ → грн рахується АВТОМАТИЧНО (Monobank API → НБУ, кеш 1 год).
# Ця змінна — лише ФОЛБЕК, якщо обидва API недоступні. За замовч. 42.
USD_UAH_RATE=42
